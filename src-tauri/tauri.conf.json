{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 600,
        "title": "alpine",
        "width": 800,
        "decorations": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run start",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/alpine/browser"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/game_map.csv": "game_map.csv"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "iOS": {
      "developmentTeam": "S33LPKH83B",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "rpm": {
        "epoch": 0,
        "release": "1"
      }
    }
  },
  "identifier": "com.alpinebits.echo",
  "productName": "Echo",
  "version": "3.0.71",
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://api.alpinebits.ch/api/v1/update/check/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4OUQwRTkwQzBDOTM5MTEKUldRUk9jbkFrQTZkdUdIaTg1UmhlbHRSNVJ2Nyt2Qk1KWVA1Nk1BeCtGUTJTTkR3OC82ZnBXTisK"
    }
  }
}