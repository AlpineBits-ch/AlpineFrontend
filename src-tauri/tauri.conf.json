{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 600,
        "title": "alpine",
        "width": 800,
        "decorations": false,
        "focus": false
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run start",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/alpine/browser"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "iOS": {
      "developmentTeam": "S33LPKH83B"
    }
  },
  "identifier": "com.alpinebits.echo",
  "productName": "Echo",
  "version": "3.0.38",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.alpinebits.ch/api/v1/update/check/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4OUQwRTkwQzBDOTM5MTEKUldRUk9jbkFrQTZkdUdIaTg1UmhlbHRSNVJ2Nyt2Qk1KWVA1Nk1BeCtGUTJTTkR3OC82ZnBXTisK"
    }
  }
}