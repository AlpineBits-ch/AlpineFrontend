{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "echo", "login"
  ],
  "permissions": [
    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "window-state:default",
    "os:default",
    "notifications:default",
    "secure-storage:default"
  ]
}
