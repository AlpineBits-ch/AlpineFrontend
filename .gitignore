# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Staging directory for the E2E client image. .github/workflows/e2e-client-image.yml assembles the
# docker build context here (built output + docker/e2e/nginx.conf and nothing else) so that no
# source can enter the context in the first place.
/.image-context

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

.zed/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# Sentry Config File
.sentryclirc

# Superpowers subagent-driven-development scratch workspace
.superpowers/

# The SADIE II measurements the bundled HRIR sphere is built from.
#
# A 112 MB build input, not a source file: the sphere it produces
# (src-tauri/assets/hrir/sadie_d1_48k.bin) is what ships, and it is committed. GitHub rejects any
# push carrying a file this large, so an accidental `git add -A` here blocks the whole branch
# rather than just adding weight. src-tauri/assets/hrir/NOTICE.md has the Zenodo record to fetch it
# from and the command to regenerate the sphere.
D1.zip

# Transcripts from scripts/run-release.mjs. One file per run of the release build; useful to
# attach to a bug report, never useful to commit.
/logs
